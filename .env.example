# Server only. Create a key in Ling Studio; never use a NEXT_PUBLIC_ prefix.
MING_API_KEY=

# Local dev on 127.0.0.1 works without this password.
# Required for live voice in production. HTTP Basic username: parent.
# Set a long, unique password and serve production over HTTPS.
APP_PASSWORD=

# Optional external origin when serving behind an HTTPS reverse proxy.
# Example: https://your-domain.example (no trailing path)
APP_ORIGIN=
